# NyayaAI Environment Configuration
# Copy this file to .env and configure your values

# OpenAI Configuration (Optional: NyayaAI operates with high-fidelity verified fallback if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./nyayaai.db

# Security & Limits
MAX_UPLOAD_MB=15

# Demo & Verification
DEMO_MODE_DEFAULT=true
