# NyayaAI Environment Configuration
# Copy this file to .env and configure your values

# Google Gemini API Configuration (Recommended primary LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (MongoDB on localhost:27017)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=nyayaai

# Alternative / Legacy Fallback AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security & Limits
MAX_UPLOAD_MB=15

# Demo & Verification
DEMO_MODE_DEFAULT=true
